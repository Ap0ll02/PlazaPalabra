; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PlazaPalabra"
config/description="A short narrative Spanish language-learning game with turn-based, grammar-driven combat."
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

StudySession="*res://scripts/autoload/study_session.gd"
PlayerProfile="*res://scripts/autoload/player_profile.gd"
GameState="*res://scripts/autoload/game_state.gd"
WordBank="*res://scripts/autoload/word_bank.gd"
Settings="*res://scripts/autoload/settings.gd"
Dialogue="*res://scenes/ui/DialogueBox.tscn"
SpellBank="*res://scripts/autoload/spell_bank.gd"
SpellProgress="*res://scripts/autoload/spell_progress.gd"
Spellbook="*res://scenes/ui/Spellbook.tscn"
Lesson="*res://scenes/ui/Lesson.tscn"
Combat="*res://scenes/ui/BattleScreen.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="mobile"
