[node name="ConsentText" type="Label" parent="Margin/VBox/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
text = "You are being invited to take part in a research study about language learning through gameplay.

What you will do: play a short (10-20 minute) narrative game, answer a brief survey before and after playing, and complete a short vocabulary recall quiz at the end.

Data collected: your in-game actions (e.g. words encountered, hints used, combat choices) and your survey/quiz answers. This data is stored locally on this computer and is not linked to your name.

Voluntary participation: you may stop at any time without penalty. Declining below will not affect you in any way.

Contact: [researcher name / email / IRB contact placeholder]."
autowrap_mode = 2

[node name="ButtonRow" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
